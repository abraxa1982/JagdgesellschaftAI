{% extends 'base.html.twig' %}

{% block title %}Jagdgesellschaft – Gilden-Portal{% endblock %}

{% block styles %}
    .hero {
        text-align: center;
        padding: 3rem 1rem;
        border-bottom: 1px solid #2a2010;
        margin-bottom: 2.5rem;
    }

    .hero img {
        width: 180px;
        height: 180px;
        object-fit: contain;
        border-radius: 12px;
        box-shadow: 0 0 40px rgba(200, 169, 110, 0.25);
        margin-bottom: 1.5rem;
    }

    .hero h2 {
        font-size: 2rem;
        color: #c8a96e;
        margin-bottom: 0.75rem;
        text-shadow: 0 0 30px rgba(200, 169, 110, 0.3);
    }

    .hero p {
        color: #a09070;
        font-size: 1.05rem;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .features {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.25rem;
    }

    .feature-card {
        background: #141008;
        border: 1px solid #2a2010;
        border-radius: 8px;
        padding: 1.5rem;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .feature-card:hover {
        border-color: #4a3c1e;
        box-shadow: 0 0 20px rgba(200, 169, 110, 0.08);
    }

    .feature-card .icon {
        font-size: 1.8rem;
        margin-bottom: 0.75rem;
    }

    .feature-card h3 {
        color: #c8a96e;
        font-size: 1rem;
        margin-bottom: 0.5rem;
    }

    .feature-card p {
        color: #7a6a50;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .badge {
        display: inline-block;
        font-size: 0.7rem;
        padding: 0.15rem 0.5rem;
        border-radius: 99px;
        margin-top: 0.75rem;
        background: #1e1808;
        border: 1px solid #3a2e10;
        color: #8a7040;
        letter-spacing: 0.05em;
    }

    .badge.planned { border-color: #2a3a1e; color: #608040; background: #101808; }
{% endblock %}

{% block body %}
    <div class="hero">
        <img src="{{ asset('images/jagdgesellschaft.png') }}" alt="Jagdgesellschaft">
        <h2>Willkommen in der Jagdgesellschaft</h2>
        <p>
            Ein Gilden-Portal für unsere World of Warcraft Gemeinschaft –
            von Mitgliedern, für Mitglieder. Hier entsteht eine Übersicht
            über unsere Charaktere, Erfolge, Dungeons und vieles mehr.
        </p>
    </div>

    <div class="features">
        <div class="feature-card">
            <div class="icon">⚔️</div>
            <h3>Gildenmitglieder</h3>
            <p>Übersicht aller Mitglieder mit Charakteren, Wertung, Berufen und Twinks – endlich weiß jeder, wie die Twinks heißen.</p>
            <span class="badge planned">Geplant</span>
        </div>

        <div class="feature-card">
            <div class="icon">🐾</div>
            <h3>Charakterprofile</h3>
            <p>Pets, Reittiere, Häuser, Spezifikationen und Vorlieben – alles auf einen Blick, animiert und übersichtlich.</p>
            <span class="badge planned">Geplant</span>
        </div>

        <div class="feature-card">
            <div class="icon">🎬</div>
            <h3>Videos & Clips</h3>
            <p>Katalorisierung aller Videos und Clips, die über die Jahre entstanden sind – immer verfügbar, nie verloren.</p>
            <span class="badge planned">Geplant</span>
        </div>

        <div class="feature-card">
            <div class="icon">🗡️</div>
            <h3>Aktuelle Dungeons</h3>
            <p>Anzeige der zuletzt gelaufenen Dungeons direkt aus der Blizzard API – immer aktuell.</p>
            <span class="badge planned">Geplant</span>
        </div>

        <div class="feature-card">
            <div class="icon">🛡️</div>
            <h3>BIS Gear Übersicht</h3>
            <p>Best-in-Slot Ausrüstung für jede Klasse und Spezialisierung – damit die Vorbereitung stimmt.</p>
            <span class="badge planned">Geplant</span>
        </div>

        <div class="feature-card">
            <div class="icon">📅</div>
            <h3>Gildenkalender</h3>
            <p>Gemeinsame Events, Raidtermine und Aktivitäten – koordiniert und übersichtlich für alle Mitglieder.</p>
            <span class="badge planned">Geplant</span>
        </div>
    </div>
{% endblock %}