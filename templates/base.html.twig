<!DOCTYPE html>
<html lang="de">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Jagdgesellschaft{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/jagdgesellschaft.png') }}">
        <style>
            *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

            body {
                font-family: 'Segoe UI', system-ui, sans-serif;
                background: #0d0d0d;
                color: #e8e0d0;
                min-height: 100vh;
            }

            header {
                background: linear-gradient(180deg, #1a1008 0%, #0d0d0d 100%);
                border-bottom: 1px solid #4a3c1e;
                padding: 1rem 2rem;
                display: flex;
                align-items: center;
                gap: 1rem;
            }

            header img { height: 48px; border-radius: 4px; }

            header h1 {
                font-size: 1.4rem;
                color: #c8a96e;
                letter-spacing: 0.05em;
                text-shadow: 0 0 20px rgba(200, 169, 110, 0.4);
            }

            main { padding: 2rem; max-width: 1100px; margin: 0 auto; }

            {% block styles %}{% endblock %}
        </style>
        {% block head %}{% endblock %}
    </head>
    <body>
        <header>
            <img src="{{ asset('images/jagdgesellschaft.png') }}" alt="Jagdgesellschaft Logo">
            <h1>Jagdgesellschaft</h1>
        </header>

        <main>
            {% block body %}{% endblock %}
        </main>
    </body>
</html>